---
/**
 * ProjectExpanded Component
 *
 * Full-screen expanded view when a project is selected.
 * Shows large image on the left and project info on the right.
 * The carousel fades out with blur when this view is active.
 */

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div id="project-expanded" class:list={['project-expanded', className]}>
  <!-- Large project image -->
  <div class="project-expanded__image-container">
    <div class="project-expanded__image-wrapper">
      <img id="expanded-image" class="project-expanded__image" src="" alt="" />
      <div class="project-expanded__image-overlay"></div>
    </div>
  </div>

  <!-- Project info panel -->
  <aside class="project-expanded__info">
    <div class="project-expanded__content">
      <header class="project-expanded__header">
        <span class="project-expanded__year" id="expanded-year"></span>
        <h2 class="project-expanded__title" id="expanded-title">Título del Proyecto</h2>
        <span class="project-expanded__role" id="expanded-role"></span>
      </header>

      <div class="project-expanded__tags" id="expanded-tags"></div>

      <p class="project-expanded__description" id="expanded-desc">
        Descripción del proyecto...
      </p>

      <div class="project-expanded__links" id="expanded-links"></div>

      <button id="expanded-close-btn" class="project-expanded__close" type="button">
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
        >
          <path d="M19 12H5M12 19l-7-7 7-7"></path>
        </svg>
        <span>Volver al Carrusel</span>
      </button>
    </div>
  </aside>
</div>

<script>
  import type { Project } from '../../types/project';

  class ProjectExpandedController {
    private container: HTMLElement | null;
    private imageEl: HTMLImageElement | null;
    private titleEl: HTMLElement | null;
    private descEl: HTMLElement | null;
    private tagsEl: HTMLElement | null;
    private linksEl: HTMLElement | null;
    private yearEl: HTMLElement | null;
    private roleEl: HTMLElement | null;
    private closeBtn: HTMLElement | null;
    private carouselContainer: HTMLElement | null;

    constructor() {
      this.container = document.getElementById('project-expanded');
      this.imageEl = document.getElementById('expanded-image') as HTMLImageElement;
      this.titleEl = document.getElementById('expanded-title');
      this.descEl = document.getElementById('expanded-desc');
      this.tagsEl = document.getElementById('expanded-tags');
      this.linksEl = document.getElementById('expanded-links');
      this.yearEl = document.getElementById('expanded-year');
      this.roleEl = document.getElementById('expanded-role');
      this.closeBtn = document.getElementById('expanded-close-btn');
      this.carouselContainer = document.getElementById('carousel-container');

      if (this.container && this.imageEl) {
        this.setupEventListeners();
        console.log('ProjectExpandedController initialized');
      }
    }

    private setupEventListeners(): void {
      // Listen for project selection
      document.addEventListener('project-selected', ((event: CustomEvent) => {
        const { project } = event.detail;
        if (project) {
          this.show(project);
        }
      }) as EventListener);

      // Listen for project deselection
      document.addEventListener('project-deselected', () => {
        this.hide();
      });

      // Close button
      if (this.closeBtn) {
        this.closeBtn.addEventListener('click', () => {
          if ((window as any).resetCarouselView) {
            (window as any).resetCarouselView();
          }
        });
      }

      // Escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && this.container?.classList.contains('active')) {
          if ((window as any).resetCarouselView) {
            (window as any).resetCarouselView();
          }
        }
      });
    }

    private show(project: Project): void {
      if (!this.container || !this.imageEl) return;

      console.log('Showing expanded view for:', project.title);

      // Update image
      this.imageEl.src = project.image;
      this.imageEl.alt = project.title;

      // Update content
      if (this.titleEl) this.titleEl.textContent = project.title;
      if (this.descEl) this.descEl.textContent = project.longDescription || project.description;

      // Year
      if (this.yearEl) {
        if (project.year) {
          this.yearEl.textContent = project.year.toString();
          this.yearEl.style.display = 'block';
        } else {
          this.yearEl.style.display = 'none';
        }
      }

      // Role
      if (this.roleEl) {
        if (project.role) {
          this.roleEl.textContent = project.role;
          this.roleEl.style.display = 'block';
        } else {
          this.roleEl.style.display = 'none';
        }
      }

      // Tags
      if (this.tagsEl) {
        this.tagsEl.innerHTML = '';
        project.tags.forEach((tag) => {
          const span = document.createElement('span');
          span.className = 'tag';
          span.textContent = tag;
          this.tagsEl!.appendChild(span);
        });
      }

      // Links
      if (this.linksEl) {
        this.linksEl.innerHTML = '';
        if (project.links && project.links.length > 0) {
          project.links.forEach((link) => {
            const a = document.createElement('a');
            a.href = link.url;
            a.target = '_blank';
            a.rel = 'noopener noreferrer';
            a.className = `link link--${link.type}`;
            a.innerHTML = this.getLinkIcon(link.type) + (link.label || this.getLinkLabel(link.type));
            this.linksEl!.appendChild(a);
          });
        }
      }

      // Apply color accent from project
      if (project.color) {
        this.container.style.setProperty('--project-color', project.color);
      }

      // Show expanded view and blur carousel
      this.container.classList.add('active');
      this.carouselContainer?.classList.add('blurred');
    }

    private hide(): void {
      if (this.container) {
        this.container.classList.remove('active');
      }
      this.carouselContainer?.classList.remove('blurred');
    }

    private getLinkIcon(type: string): string {
      const icons: Record<string, string> = {
        github: `<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>`,
        live: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>`,
        demo: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>`,
        documentation: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>`
      };
      return icons[type] || '';
    }

    private getLinkLabel(type: string): string {
      const labels: Record<string, string> = {
        github: 'Ver Código',
        live: 'Ver Proyecto',
        demo: 'Ver Demo',
        documentation: 'Documentación'
      };
      return labels[type] || 'Ver';
    }
  }

  // Initialize when DOM is ready
  function init() {
    new ProjectExpandedController();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

<style>
  .project-expanded {
    position: fixed;
    inset: 0;
    z-index: 300;
    display: grid;
    grid-template-columns: 1fr 450px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.5s ease, visibility 0.5s ease;
  }

  .project-expanded.active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  /* Image container - left side */
  .project-expanded__image-container {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 60px;
    background: rgba(5, 5, 10, 0.9);
    overflow: hidden;
  }

  .project-expanded__image-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    max-width: 900px;
    max-height: 80vh;
    border-radius: 20px;
    overflow: hidden;
    box-shadow:
      0 50px 100px -20px rgba(0, 0, 0, 0.7),
      0 0 60px rgba(var(--project-color-rgb, 0, 212, 255), 0.2);
    transform: scale(0.9) translateX(-50px);
    opacity: 0;
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.5s ease;
  }

  .project-expanded.active .project-expanded__image-wrapper {
    transform: scale(1) translateX(0);
    opacity: 1;
    transition-delay: 0.1s;
  }

  .project-expanded__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: rgba(0, 0, 0, 0.3);
  }

  .project-expanded__image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      transparent 0%,
      rgba(var(--project-color-rgb, 0, 212, 255), 0.1) 100%
    );
    pointer-events: none;
  }

  /* Info panel - right side */
  .project-expanded__info {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 60px 40px;
    background: rgba(10, 10, 15, 0.98);
    border-left: 1px solid rgba(255, 255, 255, 0.08);
    transform: translateX(100%);
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-expanded.active .project-expanded__info {
    transform: translateX(0);
    transition-delay: 0.15s;
  }

  .project-expanded__content {
    max-height: calc(100vh - 120px);
    overflow-y: auto;
    padding-right: 10px;
  }

  .project-expanded__header {
    margin-bottom: 24px;
  }

  .project-expanded__year {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--project-color, var(--accent-color, #00d4ff));
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 12px;
    padding: 4px 12px;
    background: rgba(var(--project-color-rgb, 0, 212, 255), 0.15);
    border-radius: 20px;
  }

  .project-expanded__title {
    margin: 0 0 12px 0;
    font-size: 2.25rem;
    font-weight: 800;
    color: #ffffff;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .project-expanded__role {
    display: block;
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.6);
    font-style: italic;
  }

  .project-expanded__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 28px;
  }

  .project-expanded__tags :global(.tag) {
    display: inline-flex;
    align-items: center;
    padding: 8px 16px;
    background: rgba(255, 255, 255, 0.06);
    color: rgba(255, 255, 255, 0.85);
    border-radius: 25px;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition: all 0.2s ease;
  }

  .project-expanded__tags :global(.tag:hover) {
    background: rgba(255, 255, 255, 0.12);
    transform: translateY(-2px);
  }

  .project-expanded__description {
    font-size: 1.0625rem;
    line-height: 1.8;
    color: rgba(255, 255, 255, 0.75);
    margin: 0 0 32px 0;
  }

  .project-expanded__links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-bottom: 40px;
  }

  .project-expanded__links :global(.link) {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 24px;
    background: rgba(255, 255, 255, 0.05);
    color: #ffffff;
    text-decoration: none;
    border-radius: 14px;
    font-size: 0.9375rem;
    font-weight: 600;
    border: 1px solid rgba(255, 255, 255, 0.12);
    transition: all 0.25s ease;
  }

  .project-expanded__links :global(.link:hover) {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.25);
    transform: translateY(-3px);
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
  }

  .project-expanded__links :global(.link--live) {
    background: linear-gradient(135deg, rgba(var(--project-color-rgb, 0, 212, 255), 0.2) 0%, rgba(var(--project-color-rgb, 0, 212, 255), 0.1) 100%);
    border-color: rgba(var(--project-color-rgb, 0, 212, 255), 0.3);
  }

  .project-expanded__links :global(.link--live:hover) {
    background: linear-gradient(135deg, rgba(var(--project-color-rgb, 0, 212, 255), 0.35) 0%, rgba(var(--project-color-rgb, 0, 212, 255), 0.2) 100%);
  }

  .project-expanded__close {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 28px;
    background: transparent;
    color: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 14px;
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.25s ease;
    font-family: inherit;
  }

  .project-expanded__close:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.35);
    transform: translateX(-5px);
  }

  .project-expanded__close:focus {
    outline: none;
    box-shadow: 0 0 0 3px rgba(var(--project-color-rgb, 0, 212, 255), 0.4);
  }

  /* Scrollbar styling */
  .project-expanded__content::-webkit-scrollbar {
    width: 5px;
  }

  .project-expanded__content::-webkit-scrollbar-track {
    background: transparent;
  }

  .project-expanded__content::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.15);
    border-radius: 3px;
  }

  .project-expanded__content::-webkit-scrollbar-thumb:hover {
    background: rgba(255, 255, 255, 0.25);
  }

  /* Mobile adjustments */
  @media (max-width: 1024px) {
    .project-expanded {
      grid-template-columns: 1fr;
      grid-template-rows: 45vh 1fr;
    }

    .project-expanded__image-container {
      padding: 30px;
    }

    .project-expanded__image-wrapper {
      max-height: 100%;
    }

    .project-expanded__info {
      padding: 30px 24px;
      border-left: none;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      transform: translateY(100%);
    }

    .project-expanded.active .project-expanded__info {
      transform: translateY(0);
    }

    .project-expanded__title {
      font-size: 1.75rem;
    }
  }

  @media (max-width: 640px) {
    .project-expanded {
      grid-template-rows: 35vh 1fr;
    }

    .project-expanded__image-container {
      padding: 20px;
    }

    .project-expanded__info {
      padding: 24px 20px;
    }

    .project-expanded__title {
      font-size: 1.5rem;
    }

    .project-expanded__description {
      font-size: 0.9375rem;
    }
  }
</style>
