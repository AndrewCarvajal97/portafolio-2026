---
/**
 * AboutSection Component
 *
 * Displays information about the developer including
 * photo, skills (technical and soft), experience, and background.
 * Optimized for responsive design.
 */

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const technicalSkills = [
  { category: 'Frontend', items: ['React', 'Vue.js', 'TypeScript', 'Next.js', 'Astro'] },
  { category: 'Backend', items: ['Node.js', 'Python', 'Go', 'PostgreSQL', 'MongoDB'] },
  { category: 'DevOps', items: ['Docker', 'Kubernetes', 'AWS', 'CI/CD', 'Terraform'] },
  { category: 'Tools', items: ['Git', 'Linux', 'Figma', 'Jira', 'Notion'] }
];

const softSkills = [
  'Liderazgo',
  'Comunicación',
  'Problem Solving',
  'Adaptabilidad',
  'Trabajo en equipo',
  'Gestión del tiempo',
  'Pensamiento crítico',
  'Creatividad',
  'Proactividad',
  'Empatía'
];

const stats = [
  { value: '3+', label: 'Años Exp.' },
  { value: '50+', label: 'Proyectos' },
  { value: '20+', label: 'Clientes' },
  { value: '10+', label: 'Tecnologías' }
];
---

<section class:list={['about-section', className]}>
  <div class="about-section__container">
    <!-- Left column: Photo and intro -->
    <div class="about-section__left">
      <div class="about-section__photo-wrapper">
        <div class="about-section__photo">
          <img
            src="/images/profile.jpg"
            alt="Andres Carvajal"
            class="about-section__photo-img"
            onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
          />
          <div class="about-section__photo-placeholder">
            <span class="about-section__photo-initials">AC</span>
          </div>
        </div>
        <div class="about-section__photo-glow"></div>
      </div>

      <div class="about-section__intro-content">
        <h2 class="about-section__title">
          <span class="about-section__title-accent">Sobre</span> Mí
        </h2>

        <p class="about-section__intro">
          Desarrollador Full Stack y CTO con más de 3 años de experiencia
          creando soluciones digitales innovadoras.
        </p>

        <p class="about-section__description">
          He liderado equipos de desarrollo, diseñado arquitecturas escalables y
          entregado proyectos que han impactado positivamente a miles de usuarios.
        </p>

        <div class="about-section__stats">
          {
            stats.map((stat) => (
              <div class="stat">
                <span class="stat__value">{stat.value}</span>
                <span class="stat__label">{stat.label}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Right column: Skills -->
    <div class="about-section__right">
      <!-- Technical Skills -->
      <div class="about-section__skills-section">
        <h3 class="about-section__subtitle">Habilidades Técnicas</h3>

        <div class="skills-grid">
          {
            technicalSkills.map((skillGroup) => (
              <div class="skill-group">
                <h4 class="skill-group__title">{skillGroup.category}</h4>
                <div class="skill-group__items">
                  {skillGroup.items.map((skill) => (
                    <span class="skill-tag">{skill}</span>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Soft Skills -->
      <div class="about-section__skills-section">
        <h3 class="about-section__subtitle">Habilidades Blandas</h3>

        <div class="soft-skills-list">
          {
            softSkills.map((skill) => (
              <span class="soft-skill-tag">{skill}</span>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about-section {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 80px 24px 60px;
    min-height: 100vh;
    z-index: 2;
    background: linear-gradient(180deg, rgba(10, 10, 15, 0.95) 0%, rgba(5, 5, 10, 0.98) 100%);
  }

  .about-section__container {
    max-width: 1100px;
    width: 100%;
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 50px;
    align-items: start;
  }

  /* Left Column - Photo and Intro */
  .about-section__left {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .about-section__photo-wrapper {
    position: relative;
    display: flex;
    justify-content: center;
  }

  .about-section__photo {
    position: relative;
    width: 180px;
    height: 180px;
    border-radius: 20px;
    overflow: hidden;
    border: 2px solid rgba(0, 212, 255, 0.3);
    background: rgba(20, 20, 30, 0.8);
    z-index: 1;
  }

  .about-section__photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-section__photo-placeholder {
    display: none;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, rgba(0, 212, 255, 0.2) 0%, rgba(255, 0, 212, 0.2) 100%);
  }

  .about-section__photo-initials {
    font-size: 3.5rem;
    font-weight: 800;
    color: rgba(255, 255, 255, 0.9);
    text-shadow: 0 4px 20px rgba(0, 212, 255, 0.5);
  }

  .about-section__photo-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 220px;
    height: 220px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0, 212, 255, 0.25) 0%, transparent 70%);
    filter: blur(30px);
    z-index: 0;
    animation: pulseGlow 4s ease-in-out infinite;
  }

  @keyframes pulseGlow {
    0%, 100% { opacity: 0.5; transform: translate(-50%, -50%) scale(1); }
    50% { opacity: 0.7; transform: translate(-50%, -50%) scale(1.05); }
  }

  .about-section__intro-content {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .about-section__title {
    font-size: 2rem;
    font-weight: 800;
    margin: 0;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .about-section__title-accent {
    color: var(--accent-color, #00d4ff);
  }

  .about-section__intro {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.6;
    margin: 0;
  }

  .about-section__description {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.6);
    line-height: 1.6;
    margin: 0;
  }

  .about-section__stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-top: 12px;
    padding: 16px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }

  .stat__value {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--accent-color, #00d4ff);
    line-height: 1;
  }

  .stat__label {
    font-size: 0.65rem;
    color: rgba(255, 255, 255, 0.5);
    text-align: center;
  }

  /* Right Column - Skills */
  .about-section__right {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .about-section__skills-section {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .about-section__subtitle {
    font-size: 1.1rem;
    font-weight: 700;
    margin: 0;
    color: rgba(255, 255, 255, 0.95);
  }

  /* Technical Skills Grid */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }

  .skill-group {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 14px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    transition: all 0.3s ease;
  }

  .skill-group:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(0, 212, 255, 0.2);
  }

  .skill-group__title {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--accent-color, #00d4ff);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0;
  }

  .skill-group__items {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .skill-tag {
    display: inline-flex;
    align-items: center;
    padding: 4px 10px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.8);
    transition: all 0.2s ease;
  }

  .skill-tag:hover {
    background: rgba(0, 212, 255, 0.15);
    border-color: rgba(0, 212, 255, 0.3);
    color: var(--accent-color, #00d4ff);
  }

  /* Soft Skills - Compact pill tags */
  .soft-skills-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .soft-skill-tag {
    display: inline-block;
    padding: 6px 14px;
    background: linear-gradient(135deg, rgba(255, 0, 212, 0.08) 0%, rgba(0, 212, 255, 0.08) 100%);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 50px;
    font-size: 0.8rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.85);
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .soft-skill-tag:hover {
    background: linear-gradient(135deg, rgba(255, 0, 212, 0.15) 0%, rgba(0, 212, 255, 0.15) 100%);
    border-color: rgba(255, 255, 255, 0.2);
    color: #fff;
    transform: translateY(-2px);
  }

  /* Responsive - Tablet */
  @media (max-width: 900px) {
    .about-section {
      padding: 80px 20px 50px;
    }

    .about-section__container {
      grid-template-columns: 1fr;
      gap: 40px;
      max-width: 600px;
    }

    .about-section__left {
      flex-direction: row;
      align-items: center;
      gap: 24px;
    }

    .about-section__photo-wrapper {
      flex-shrink: 0;
    }

    .about-section__photo {
      width: 140px;
      height: 140px;
    }

    .about-section__photo-initials {
      font-size: 2.5rem;
    }

    .about-section__photo-glow {
      width: 170px;
      height: 170px;
    }

    .about-section__title {
      font-size: 1.75rem;
    }

    .about-section__stats {
      grid-template-columns: repeat(4, 1fr);
    }

    .skills-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* Responsive - Mobile */
  @media (max-width: 640px) {
    .about-section {
      padding: 80px 16px 40px;
    }

    .about-section__container {
      gap: 32px;
    }

    .about-section__left {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .about-section__photo {
      width: 120px;
      height: 120px;
    }

    .about-section__photo-initials {
      font-size: 2rem;
    }

    .about-section__title {
      font-size: 1.5rem;
    }

    .about-section__intro {
      font-size: 0.9rem;
    }

    .about-section__description {
      font-size: 0.85rem;
    }

    .about-section__stats {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
      padding: 14px;
    }

    .stat__value {
      font-size: 1.25rem;
    }

    .stat__label {
      font-size: 0.6rem;
    }

    .about-section__subtitle {
      font-size: 1rem;
    }

    .skills-grid {
      grid-template-columns: 1fr;
    }

    .skill-group {
      padding: 12px;
    }

    .soft-skills-list {
      justify-content: center;
    }

    .soft-skill-tag {
      padding: 6px 12px;
      font-size: 0.75rem;
    }
  }

  /* Very small screens */
  @media (max-width: 380px) {
    .about-section {
      padding: 70px 12px 30px;
    }

    .about-section__photo {
      width: 100px;
      height: 100px;
    }

    .about-section__stats {
      padding: 12px;
      gap: 12px;
    }
  }
</style>
