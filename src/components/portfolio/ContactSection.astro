---
/**
 * ContactSection Component
 *
 * Interactive contact section with 3D tilt parallax on every card.
 * WhatsApp is the primary CTA (formatted phone, hover glow, quick reply badge).
 * Secondary methods (email, LinkedIn, GitHub) live in a smaller tilt grid.
 */

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const WHATSAPP_PHONE_DISPLAY = '+57 302 528 8271';
const WHATSAPP_NUMBER_INTL = '573025288271';
const WHATSAPP_MESSAGE = encodeURIComponent(
  'Hola Pablo, vi tu portafolio y quiero hablar contigo sobre un proyecto.'
);
const WHATSAPP_HREF = `https://wa.me/${WHATSAPP_NUMBER_INTL}?text=${WHATSAPP_MESSAGE}`;
const TEL_HREF = `tel:+${WHATSAPP_NUMBER_INTL}`;

const channels = [
  {
    id: 'email',
    label: 'Email',
    handle: 'andrewcarvajal97@gmail.com',
    href: 'mailto:andrewcarvajal97@gmail.com',
    color: '#00d4ff'
  },
  {
    id: 'linkedin',
    label: 'LinkedIn',
    handle: '/in/pablo-andres-carvajal-ramirez',
    href: 'https://www.linkedin.com/in/pablo-andres-carvajal-ramirez-8114162aa/',
    color: '#0a66c2'
  },
  {
    id: 'github',
    label: 'GitHub',
    handle: '@AndrewCarvajal97',
    href: 'https://github.com/AndrewCarvajal97',
    color: '#a78bfa'
  }
];
---

<section class:list={['contact-section', className]} id="contact-stage" aria-labelledby="contact-title">
  <div class="contact-section__bg" aria-hidden="true">
    <div class="contact-section__orb contact-section__orb--a"></div>
    <div class="contact-section__orb contact-section__orb--b"></div>
    <div class="contact-section__grid"></div>
  </div>

  <div class="contact-section__container">
    <header class="contact-section__header">
      <span class="contact-section__eyebrow">
        <span class="contact-section__status-dot" aria-hidden="true"></span>
        Disponible para nuevos proyectos
      </span>
      <h2 id="contact-title" class="contact-section__title">
        <span class="contact-section__title-accent">Hablemos</span> de tu proyecto
      </h2>
      <p class="contact-section__subtitle">
        Freelance, asesorías técnicas, code reviews o tech lead a tiempo parcial.
        Si tienes una idea concreta o un equipo que necesita acelerar, escríbeme.
      </p>
    </header>

    <a
      class="whatsapp-cta tilt-card"
      data-tilt
      href={WHATSAPP_HREF}
      target="_blank"
      rel="noopener noreferrer"
      aria-label={`Escribir por WhatsApp a ${WHATSAPP_PHONE_DISPLAY}`}
    >
      <span class="whatsapp-cta__glow" aria-hidden="true"></span>
      <div class="whatsapp-cta__inner">
        <div class="whatsapp-cta__icon" aria-hidden="true">
          <svg viewBox="0 0 32 32" width="36" height="36" fill="currentColor">
            <path d="M19.11 17.205c-.372 0-1.088 1.39-1.518 1.39a.63.63 0 0 1-.315-.1c-.802-.402-1.504-.817-2.163-1.447-.545-.516-1.146-1.29-1.46-1.963a.426.426 0 0 1-.073-.215c0-.33.99-.945.99-1.49 0-.143-.73-2.09-.832-2.335-.143-.372-.214-.487-.6-.487-.187 0-.36-.043-.53-.043-.302 0-.53.115-.746.315-.688.645-1.032 1.318-1.06 2.247v.214c-.015.99.472 1.977 1.017 2.78 1.23 1.82 2.404 3.045 4.5 3.93.402.143.873.36 1.318.36.616 0 1.232-.388 1.46-.66.115-.143.387-.502.387-.78s-.072-.43-.244-.516c-.187-.115-1.103-.547-1.275-.547zM16 0C7.16 0 0 7.16 0 16c0 2.93.79 5.81 2.31 8.31L0 32l7.85-2.27A15.94 15.94 0 0 0 16 32c8.84 0 16-7.16 16-16S24.84 0 16 0zm0 29.31c-2.59 0-5.13-.7-7.34-2.01l-.53-.32-5.46 1.58 1.6-5.32-.34-.55a13.3 13.3 0 0 1-2.04-7.07c0-7.36 5.99-13.35 13.35-13.35 7.35 0 13.35 5.99 13.35 13.35 0 7.36-5.99 13.35-13.35 13.35z"/>
          </svg>
        </div>
        <div class="whatsapp-cta__body">
          <span class="whatsapp-cta__eyebrow">
            <span class="whatsapp-cta__pulse" aria-hidden="true"></span>
            Respuesta más rápida — WhatsApp
          </span>
          <h3 class="whatsapp-cta__title">Escríbeme directo a mi celular</h3>
          <span class="whatsapp-cta__phone">{WHATSAPP_PHONE_DISPLAY}</span>
        </div>
        <span class="whatsapp-cta__arrow" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </span>
      </div>
    </a>

    <div class="quick-actions">
      <a href={TEL_HREF} class="quick-action tilt-card" data-tilt aria-label={`Llamar a ${WHATSAPP_PHONE_DISPLAY}`}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/>
        </svg>
        <span>Llamar</span>
      </a>
      <button
        type="button"
        class="quick-action tilt-card"
        data-tilt
        data-copy={WHATSAPP_PHONE_DISPLAY}
        aria-label="Copiar número al portapapeles"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
        </svg>
        <span class="quick-action__label">Copiar número</span>
      </button>
    </div>

    <div class="channels">
      {channels.map((c) => (
        <a
          class="channel tilt-card"
          data-tilt
          href={c.href}
          target={c.href.startsWith('http') ? '_blank' : null}
          rel={c.href.startsWith('http') ? 'noopener noreferrer' : null}
          style={`--channel-color: ${c.color}`}
        >
          <span class="channel__icon" aria-hidden="true">
            {c.id === 'email' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
            )}
            {c.id === 'linkedin' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
              </svg>
            )}
            {c.id === 'github' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
            )}
          </span>
          <div class="channel__body">
            <span class="channel__label">{c.label}</span>
            <span class="channel__handle">{c.handle}</span>
          </div>
          <span class="channel__arrow" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7 17L17 7M7 7h10v10"/>
            </svg>
          </span>
        </a>
      ))}
    </div>

    <footer class="contact-section__footer">
      <span class="contact-section__meta">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
          <circle cx="12" cy="10" r="3"/>
        </svg>
        Bucaramanga, Colombia · 100% remoto
      </span>
      <span class="contact-section__meta">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <polyline points="12 6 12 12 16 14"/>
        </svg>
        Suelo responder en menos de 24 h
      </span>
    </footer>
  </div>

  <div id="contact-toast" class="contact-toast" role="status" aria-live="polite"></div>
</section>

<script>
  class ContactTilt {
    private cards: HTMLElement[];
    private prefersReducedMotion: boolean;

    constructor() {
      this.cards = Array.from(document.querySelectorAll<HTMLElement>('[data-tilt]'));
      this.prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (this.prefersReducedMotion) return;
      this.cards.forEach((card) => this.attach(card));
    }

    private attach(card: HTMLElement): void {
      const state = { rx: 0, ry: 0, tx: 0, ty: 0, targetRx: 0, targetRy: 0, targetTx: 0, targetTy: 0, raf: 0 };

      const onMove = (e: PointerEvent) => {
        const rect = card.getBoundingClientRect();
        const x = (e.clientX - rect.left) / rect.width - 0.5;
        const y = (e.clientY - rect.top) / rect.height - 0.5;
        const maxTilt = card.classList.contains('whatsapp-cta') ? 7 : 9;
        state.targetRy = x * maxTilt;
        state.targetRx = -y * maxTilt;
        state.targetTx = x * 6;
        state.targetTy = y * 6;
        if (!state.raf) state.raf = requestAnimationFrame(tick);
      };

      const onLeave = () => {
        state.targetRx = 0;
        state.targetRy = 0;
        state.targetTx = 0;
        state.targetTy = 0;
        if (!state.raf) state.raf = requestAnimationFrame(tick);
      };

      const tick = () => {
        state.raf = 0;
        state.rx += (state.targetRx - state.rx) * 0.14;
        state.ry += (state.targetRy - state.ry) * 0.14;
        state.tx += (state.targetTx - state.tx) * 0.14;
        state.ty += (state.targetTy - state.ty) * 0.14;
        card.style.setProperty('--rx', `${state.rx.toFixed(2)}deg`);
        card.style.setProperty('--ry', `${state.ry.toFixed(2)}deg`);
        card.style.setProperty('--tx', `${state.tx.toFixed(2)}px`);
        card.style.setProperty('--ty', `${state.ty.toFixed(2)}px`);
        const still =
          Math.abs(state.targetRx - state.rx) < 0.01 &&
          Math.abs(state.targetRy - state.ry) < 0.01 &&
          Math.abs(state.targetTx - state.tx) < 0.01 &&
          Math.abs(state.targetTy - state.ty) < 0.01;
        if (!still) state.raf = requestAnimationFrame(tick);
      };

      card.addEventListener('pointermove', onMove);
      card.addEventListener('pointerleave', onLeave);
      card.addEventListener('blur', onLeave, true);
    }
  }

  class CopyToClipboard {
    private toast: HTMLElement | null;
    private toastTimer: number | undefined;

    constructor() {
      this.toast = document.getElementById('contact-toast');
      document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
        btn.addEventListener('click', () => this.copy(btn));
      });
    }

    private async copy(btn: HTMLButtonElement): Promise<void> {
      const text = btn.dataset.copy ?? '';
      if (!text) return;
      try {
        await navigator.clipboard.writeText(text);
        this.showToast(`Copiado: ${text}`);
        const label = btn.querySelector('.quick-action__label');
        if (label) {
          const original = label.textContent;
          label.textContent = '¡Copiado!';
          setTimeout(() => {
            if (label) label.textContent = original;
          }, 1800);
        }
      } catch {
        this.showToast('No se pudo copiar. Selecciona el número manualmente.');
      }
    }

    private showToast(message: string): void {
      if (!this.toast) return;
      this.toast.textContent = message;
      this.toast.classList.add('is-visible');
      if (this.toastTimer) window.clearTimeout(this.toastTimer);
      this.toastTimer = window.setTimeout(() => {
        this.toast?.classList.remove('is-visible');
      }, 2200);
    }
  }

  function init() {
    new ContactTilt();
    new CopyToClipboard();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

<style>
  .contact-section {
    position: relative;
    display: flex;
    align-items: flex-start; /* contenido pegado al top */
    justify-content: center;
    padding: clamp(24px, 3.5vh, 48px) 32px clamp(28px, 4vh, 56px);
    min-height: 100vh;
    min-height: 100dvh;
    z-index: 2;
    background: transparent;
    overflow: hidden;
    perspective: 1400px;
  }

  /* Background — animated orbs + grid (kept subtle, doesn't fight the carousel) */
  .contact-section__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .contact-section__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.35;
    animation: orbFloat 16s ease-in-out infinite;
  }

  .contact-section__orb--a {
    width: 520px;
    height: 520px;
    background: radial-gradient(circle, rgba(37, 211, 102, 0.45), transparent 70%);
    top: -120px;
    right: -160px;
  }

  .contact-section__orb--b {
    width: 460px;
    height: 460px;
    background: radial-gradient(circle, rgba(0, 212, 255, 0.4), transparent 70%);
    bottom: -100px;
    left: -120px;
    animation-delay: 6s;
  }

  .contact-section__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(circle at center, black 30%, transparent 80%);
    -webkit-mask-image: radial-gradient(circle at center, black 30%, transparent 80%);
  }

  @keyframes orbFloat {
    0%, 100% { transform: translate(0, 0) scale(1); opacity: 0.35; }
    50%      { transform: translate(40px, -30px) scale(1.08); opacity: 0.5; }
  }

  /* Container */
  .contact-section__container {
    position: relative;
    z-index: 1;
    max-width: 980px;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 4vh, 36px);
  }

  /* Header */
  .contact-section__header {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }

  .contact-section__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 14px;
    background: rgba(37, 211, 102, 0.1);
    border: 1px solid rgba(37, 211, 102, 0.3);
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #25d366;
  }

  .contact-section__status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #25d366;
    box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.7);
    animation: statusPulse 2s ease-out infinite;
  }

  @keyframes statusPulse {
    0%   { box-shadow: 0 0 0 0 rgba(37, 211, 102, 0.7); }
    100% { box-shadow: 0 0 0 14px rgba(37, 211, 102, 0); }
  }

  .contact-section__title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    margin: 0;
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: #ffffff;
  }

  .contact-section__title-accent {
    background: linear-gradient(135deg, #25d366 0%, var(--accent-color, #00d4ff) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .contact-section__subtitle {
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.65);
    max-width: 620px;
    margin: 0;
    line-height: 1.6;
  }

  /* Tilt cards — shared transform */
  .tilt-card {
    --rx: 0deg;
    --ry: 0deg;
    --tx: 0px;
    --ty: 0px;
    transform: perspective(1000px) rotateX(var(--rx)) rotateY(var(--ry)) translate3d(0, 0, 0);
    transform-style: preserve-3d;
    transition: box-shadow 0.3s ease, border-color 0.3s ease;
    will-change: transform;
  }

  /* WhatsApp hero CTA */
  .whatsapp-cta {
    position: relative;
    display: block;
    padding: 28px 32px;
    border-radius: 22px;
    background:
      linear-gradient(135deg, rgba(37, 211, 102, 0.22) 0%, rgba(0, 212, 255, 0.18) 100%),
      linear-gradient(180deg, rgba(20, 30, 25, 0.65), rgba(15, 20, 25, 0.65));
    border: 1px solid rgba(37, 211, 102, 0.35);
    text-decoration: none;
    color: #ffffff;
    overflow: hidden;
    box-shadow:
      0 20px 50px -20px rgba(0, 0, 0, 0.6),
      0 0 60px -25px rgba(37, 211, 102, 0.6),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }

  .whatsapp-cta:hover {
    box-shadow:
      0 30px 70px -20px rgba(0, 0, 0, 0.7),
      0 0 80px -15px rgba(37, 211, 102, 0.8),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
    border-color: rgba(37, 211, 102, 0.55);
  }

  .whatsapp-cta__glow {
    position: absolute;
    inset: -2px;
    border-radius: inherit;
    background: conic-gradient(
      from 0deg,
      transparent 0%,
      rgba(37, 211, 102, 0.4) 25%,
      transparent 50%,
      rgba(0, 212, 255, 0.4) 75%,
      transparent 100%
    );
    opacity: 0;
    transition: opacity 0.5s ease;
    z-index: 0;
    animation: glowSpin 6s linear infinite;
    filter: blur(12px);
    pointer-events: none;
  }

  .whatsapp-cta:hover .whatsapp-cta__glow {
    opacity: 0.55;
  }

  @keyframes glowSpin {
    to { transform: rotate(360deg); }
  }

  .whatsapp-cta__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 22px;
    transform: translate3d(var(--tx), var(--ty), 0);
    transition: transform 0.2s ease;
  }

  .whatsapp-cta__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 18px;
    background: #25d366;
    color: #ffffff;
    box-shadow: 0 12px 30px -10px rgba(37, 211, 102, 0.7);
    flex-shrink: 0;
    transform: translateZ(20px);
  }

  .whatsapp-cta__body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    transform: translateZ(12px);
    min-width: 0;
  }

  .whatsapp-cta__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #25d366;
  }

  .whatsapp-cta__pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #25d366;
    box-shadow: 0 0 10px #25d366;
    animation: ctaPulse 1.6s ease-in-out infinite;
  }

  @keyframes ctaPulse {
    0%, 100% { transform: scale(1);   opacity: 1;   }
    50%      { transform: scale(1.6); opacity: 0.5; }
  }

  .whatsapp-cta__title {
    margin: 0;
    font-size: 1.4rem;
    font-weight: 700;
    color: #ffffff;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .whatsapp-cta__phone {
    font-family: 'JetBrains Mono', ui-monospace, 'Cascadia Code', monospace;
    font-size: 1.1rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.95);
    letter-spacing: 0.02em;
    margin-top: 2px;
  }

  .whatsapp-cta__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.08);
    color: #ffffff;
    border: 1px solid rgba(255, 255, 255, 0.12);
    transform: translateZ(20px);
