---
/**
 * PortfolioHeader Component
 *
 * Header section displaying personal branding and navigation.
 * Supports scroll-based navigation between sections.
 */

interface Props {
  name?: string;
  title?: string;
  subtitle?: string;
  currentSection?: 'about' | 'projects' | 'contact' | 'education';
}

const {
  name = 'Pablo Andrés Carvajal',
  title = 'Full-Stack Developer & Tech Leader',
  subtitle = '+3 años de experiencia',
  currentSection = 'projects'
} = Astro.props;
---

<header class="portfolio-header">
  <div class="portfolio-header__brand">
    <a href="#section-projects" class="portfolio-header__logo" data-nav-link="projects">
      <h1 class="portfolio-header__name">{name}</h1>
    </a>
    <div class="portfolio-header__titles">
      <span class="portfolio-header__title">{title}</span>
      <span class="portfolio-header__divider">•</span>
      <span class="portfolio-header__subtitle">{subtitle}</span>
    </div>
  </div>

  <nav class="portfolio-header__nav" aria-label="Navegación principal">
    <a
      href="#section-projects"
      class:list={[
        'portfolio-header__link',
        { 'active': currentSection === 'projects' }
      ]}
      data-nav-link="projects"
      aria-current={currentSection === 'projects' ? 'true' : undefined}
    >
      Proyectos
    </a>
    <a
      href="#section-about"
      class:list={[
        'portfolio-header__link',
        { 'active': currentSection === 'about' }
      ]}
      data-nav-link="about"
      aria-current={currentSection === 'about' ? 'true' : undefined}
    >
      Sobre Mí
    </a>
    <a
      href="#section-education"
      class:list={[
        'portfolio-header__link',
        { 'active': currentSection === 'education' }
      ]}
      data-nav-link="education"
      aria-current={currentSection === 'education' ? 'true' : undefined}
    >
      Formación
    </a>
    <a
      href="#section-contact"
      class:list={[
        'portfolio-header__link',
        { 'active': currentSection === 'contact' }
      ]}
      data-nav-link="contact"
      aria-current={currentSection === 'contact' ? 'true' : undefined}
    >
      Contacto
    </a>
  </nav>
</header>

<script>
  // Listen for section changes from scroll navigator
  document.addEventListener('section-changed', ((event: CustomEvent) => {
    const { section } = event.detail;

    // Update active nav link and aria-current
    document.querySelectorAll('[data-nav-link]').forEach(link => {
      const linkSection = (link as HTMLElement).dataset.navLink;
      const isActive = linkSection === section;
      link.classList.toggle('active', isActive);
      if (isActive) {
        link.setAttribute('aria-current', 'true');
      } else {
        link.removeAttribute('aria-current');
      }
    });
  }) as EventListener);

  // Handle project expanded state - hide/show header elements
  document.addEventListener('project-selected', () => {
    const header = document.querySelector('.portfolio-header');
    if (header) {
      header.classList.add('portfolio-header--project-active');
    }
  });

  document.addEventListener('project-deselected', () => {
    const header = document.querySelector('.portfolio-header');
    if (header) {
      header.classList.remove('portfolio-header--project-active');
    }
  });
</script>

<style>
  .portfolio-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: clamp(14px, 2vw, 24px) clamp(16px, 4vw, 40px);
    padding-top: max(clamp(14px, 2vw, 24px), env(safe-area-inset-top));
    padding-left: max(clamp(16px, 4vw, 40px), env(safe-area-inset-left));
    padding-right: max(clamp(16px, 4vw, 40px), env(safe-area-inset-right));
    gap: 12px;
    z-index: 100;
    background: linear-gradient(
      to bottom,
      rgba(10, 10, 12, 0.95) 0%,
      rgba(10, 10, 12, 0) 100%
    );
    pointer-events: none;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .portfolio-header--project-active {
    opacity: 0.3;
    pointer-events: none !important;
  }

  .portfolio-header__brand {
    pointer-events: auto;
  }

  .portfolio-header__logo {
    text-decoration: none;
    display: block;
  }

  .portfolio-header__name {
    margin: 0;
    font-size: clamp(0.95rem, 2.2vw, 1.25rem);
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--accent-color, #00d4ff);
    line-height: 1;
    transition: opacity 0.2s ease;
  }

  .portfolio-header__logo:hover .portfolio-header__name {
    opacity: 0.8;
  }

  .portfolio-header__titles {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 6px;
  }

  .portfolio-header__title {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.8);
    font-weight: 500;
  }

  .portfolio-header__divider {
    color: rgba(255, 255, 255, 0.3);
    font-size: 0.75rem;
  }

  .portfolio-header__subtitle {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.5);
  }

  .portfolio-header__nav {
    display: flex;
    gap: clamp(10px, 2.5vw, 32px);
    pointer-events: auto;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .portfolio-header__link {
    position: relative;
    color: rgba(255, 255, 255, 0.6);
    font-size: clamp(0.78rem, 1.6vw, 0.875rem);
    font-weight: 500;
    letter-spacing: 0.02em;
    text-decoration: none;
    padding: 8px 4px; /* tap target ampliado */
    min-height: 32px;
    display: inline-flex;
    align-items: center;
    transition: color 0.2s ease;
  }

  .portfolio-header__link:hover {
    color: #ffffff;
  }

  .portfolio-header__link.active {
    color: var(--accent-color, #00d4ff);
  }

  .portfolio-header__link.active::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--accent-color, #00d4ff);
    border-radius: 1px;
    animation: slideIn 0.2s ease;
  }

  @keyframes slideIn {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }

  @media (max-width: 768px) {
    .portfolio-header {
      padding: 12px 16px;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      background: linear-gradient(
        to bottom,
        rgba(10, 10, 12, 0.98) 0%,
        rgba(10, 10, 12, 0.9) 80%,
        rgba(10, 10, 12, 0) 100%
      );
    }

    .portfolio-header__titles {
      display: none;
    }

    .portfolio-header__name {
      font-size: 1rem;
    }

    .portfolio-header__nav {
      gap: 16px;
    }

    .portfolio-header__link {
      font-size: 0.75rem;
    }
  }

  @media (max-width: 480px) {
    .portfolio-header {
      padding: 10px 12px;
    }

    .portfolio-header__name {
      font-size: 0.9rem;
    }

    .portfolio-header__nav {
      gap: 12px;
    }

    .portfolio-header__link {
      font-size: 0.7rem;
    }
  }
</style>
