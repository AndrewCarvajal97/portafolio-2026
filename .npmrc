# =====================================================================
# pnpm configuration — security & best-practice defaults
# Docs: https://pnpm.io/npmrc
# =====================================================================

# --- Lockfile & installs ---------------------------------------------
# Always prefer the lockfile in CI. Local installs respect the lock
# unless you explicitly bump versions with `pnpm update`.
prefer-frozen-lockfile=true

# Re-verify the integrity of every package in the global store on each
# install. Catches store corruption / tampering early.
verify-store-integrity=true

# --- Peer dependencies ------------------------------------------------
# Auto-install missing peer deps (Astro / Three.js ecosystem expects this).
auto-install-peers=true

# Don't error on peer-dep mismatches — Astro's ecosystem still has loose
# peer ranges that would otherwise block installs.
strict-peer-dependencies=false

# --- Hoisting / isolation --------------------------------------------
# Strict by default: only packages declared in package.json are reachable
# from the project root. Prevents "phantom dependencies" (importing a
# transitive dep accidentally; that dep can disappear in any update).
shamefully-hoist=false

# Public-hoist only TypeScript types so IDE intellisense keeps working.
public-hoist-pattern[]=*types*
public-hoist-pattern[]=*eslint*

# --- Registry security ------------------------------------------------
# Use only the official npm registry. Don't follow stray registry tags.
registry=https://registry.npmjs.org/

# Always check the registry for the latest metadata of cached packages.
# Tradeoff: marginally slower, much safer against stale resolutions.
fetch-retry-maxtimeout=60000
fetch-retry-mintimeout=10000
fetch-retries=3

# --- Noise reduction --------------------------------------------------
# Don't show "funding" upsell after installs.
fund=false

# Don't try to update notification banners.
update-notifier=false

# --- Dependency resolution -------------------------------------------
# Resolve to the highest semver-compatible version on first install.
# (Use `pnpm update --interactive` to bump locks deliberately.)
resolution-mode=highest

# --- Audit & lockfile -------------------------------------------------
# Stronger lockfile format with integrity hashes.
lockfile-include-tarball-url=false

# Save exact versions when running `pnpm add` (no `^` prefix).
# Comment this out if you want semver ranges instead of pinned versions.
# save-exact=true

# --- Network defaults -------------------------------------------------
# Reject self-signed certs (use only trusted CAs).
strict-ssl=true
